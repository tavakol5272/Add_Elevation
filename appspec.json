{
  "version": "1.2",
  "settings": [
    {
  "id": "height_attr_list",
  "name": "Choose the height/altitude attribute to calculate height above ground",
  "description": "Select one standard Movebank height/altitude attribute. If the correct attribute is not listed, select 'other' and enter the exact column name in the text field below.",
  "type": "DROPDOWN",
  "defaultValue": "no_selection",
  "options": [{
      "value": "no_selection",
      "displayText": "no selection"
    },
    {
      "value": "height_above_ellipsoid",
      "displayText": "height_above_ellipsoid"
    },
    {
      "value": "height_above_msl_or_mean_sea_level",
      "displayText": "height_above_mean_sea_level/msl"
    },
    {
      "value": "height_above_ground_level",
      "displayText": "height_above_ground_level"
    },
    {
      "value": "barometric_height",
      "displayText": "barometric_height"
    },
    {
      "value": "height_raw",
      "displayText": "height_raw"
    },
    {
      "value": "other",
      "displayText": "other / custom column name"
    }
    ]
 },
 {
  "id": "height_attr_freetext",
  "name": "OR provide column name of custom height/altitude attribute in the data set if not present in the selection above.",
  "description": "Use this only if you selected 'other'. Enter the exact column name as it appears in the data set.",
  "defaultValue": null,
  "type": "STRING"
	},
	{
  "id": "height_type_freetext",
  "name": "Type of the custom height/altitude attribute",
  "description": "Use this only if you selected 'other'. This tells the app how the custom height column should be interpreted.",
  "type": "DROPDOWN",
  "defaultValue": "unknown",
  "options": [
    {
      "value": "unknown",
      "displayText": "unknown / do not adapt"
    },
    {
      "value": "msl",
      "displayText": "height above mean sea level"
    },
    {
      "value": "ellipsoid",
      "displayText": "height above ellipsoid"
    },
    {
      "value": "ground_level",
      "displayText": "height above ground level"
    }
  ]
 },
 {
      "id": "height_props",
      "name": "Height thresholds for proportional use",
      "description": "Insert the required adapted heights/altitudes (in metre) for which the usage proportions shall be calculated. Values must be positive. If you want more than one height, enter them in ascending order and separate by comma. Example: 100,200,300,500. Defaults to NULL (no proportions calculated, histogram breaks regular).",
      "defaultValue": null,
      "type": "STRING"
    }
  ],
  "providedAppFiles": [
    {
      "settingId": "egm_file",
      "from": "data/auxiliary/user-files/provided-app-files/egm_file/"
    }
  ],
  "dependencies": {
    "R": [
      {
        "name": "move2"
      },
	  {
        "name": "sf"
      },
	  {
        "name": "elevatr"
      },
	  {
        "name": "terra"
      }
    ]
  },
  "createsArtifacts": true,
  "license": {
    "key": "MIT"
  },
  "language": "eng",
  "keywords": [
    "ground elevation",
    "DEM",
	"Digital Elevation Model",
    "true altitude",
	"adapted altitude",
	"height above ground",
	"geoid",
	"EGM2008"
  ],
